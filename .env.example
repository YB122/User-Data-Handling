NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/user_data_handling
# For production (e.g. MongoDB Atlas), use your own connection string:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?appName=Cluster0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
# CORS: use * for development / public APIs.
# PRODUCTION: set your frontend domain(s), e.g. https://my-app.vercel.app
# (never use * together with credentials/cookies in production)
CORS_ORIGIN=*